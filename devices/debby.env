# Device profile: Debby (oldmac, Debian)
#
# Sourced by bin/claudelitellm when the active device resolves to "debby".
# These are DEFAULTS only. Any variable you set explicitly in your shell
# (ANTHROPIC_MODEL, REAL_LITELLM_URL, etc.) still wins over the values here.
#
# To add a new device, copy this file to devices/<name>.env and adjust.

CLAUDELITELLM_DEVICE_LABEL="Debby (oldmac, Debian)"

# Default model + reasoning effort for this device.
CLAUDELITELLM_MODEL="claude-fable-5"
CLAUDELITELLM_REASONING_EFFORT="medium"

# Auto-compact keeps long sessions from overflowing context on this Debian box too.
CLAUDELITELLM_AUTOCOMPACT="true"

# Uncomment to point this device at a non-default LiteLLM endpoint.
# CLAUDELITELLM_REAL_LITELLM_URL="http://127.0.0.1:4000"
